{
  "name": "@tourpool/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"src/**/*.ts\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "create-admin": "tsx src/scripts/createAdmin.ts"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "lato-font": "^3.0.0",
    "mariadb": "^3.4.5",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.17.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
