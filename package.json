{
  "name": "tourpool",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @tourpool/api",
    "dev:admin": "npm run dev -w @tourpool/admin",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w @tourpool/api",
    "build:admin": "npm run build -w @tourpool/admin",
    "check": "npm run check -w @tourpool/api && npm exec -w @tourpool/admin -- vue-tsc -b",
    "test": "npm test -w @tourpool/api"
  }
}
