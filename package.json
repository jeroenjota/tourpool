{
  "name": "tourpool",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @tourpool/api",
    "dev:admin": "npm run dev -w @tourpool/admin",
    "dev:user": "npm run dev -w @tourpool/user",
    "dev:landing": "npm run dev -w @tourpool/landing",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w @tourpool/api",
    "build:admin": "npm run build -w @tourpool/admin",
    "build:user": "npm run build -w @tourpool/user",
    "build:landing": "npm run build -w @tourpool/landing",
    "check": "npm run check -w @tourpool/api && npm exec -w @tourpool/admin -- vue-tsc -b && npm run check -w @tourpool/user && npm run check -w @tourpool/landing",
    "test": "npm test -w @tourpool/api"
  }
}
