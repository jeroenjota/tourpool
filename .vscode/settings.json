{
  "splitHTMLAttributes.sortOrder": [
    [
      "^v-if",
      "^v-else",
      "^v-show",
      "^v-model",
      "^v-for",
      "^:key",
      "^key",
      "^v-",
      "^:",
      "^@click",
      "^@",
      "^id",
      "^class",
      "^.*=\"",
    ],
  ],
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.tabSize": 2,
  "editor.tabCompletion": "on",
  "prettier.bracketSameLine": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "markdown": true,
  },
  "remote.portsAttributes": {
    "443": {
      "protocol": "https",
    },
    "8443": {
      "protocol": "https",
    },
    "5173": {
      "application": "ignore",
    },
  },
  "git.confirmSync": false,
  "window.newWindowProfile": "Default",
  "workbench.preferredHighContrastColorTheme": "Default High Contrast Light",
  "material-icon-theme.activeIconPack": "vue",
  "files.autoSave": "onFocusChange",
  "debug.javascript.autoAttachFilter": "disabled",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.externalBrowser": "Firefox",
  "livePreview.customExternalBrowser": "Firefox",
  "liveServer.settings.AdvanceCustomBrowserCmdLine": "",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.rulers": [120],
  "css.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "postcss",
  },
  "editor.wordWrap": "on",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "terminal.integrated.initialHint": false,
  "chat.viewSessions.orientation": "stacked",
  "diffEditor.maxComputationTime": 0,
  "workbench.layoutControl.enabled": false,
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "todo-tree.highlights.useColourScheme": true,
  "claudeCode.preferredLocation": "panel",
